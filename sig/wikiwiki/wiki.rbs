module Wikiwiki
  class Wiki
    def initialize: (wiki_id: String, auth: Auth::Password | Auth::ApiKey, ?rate_limiter: RateLimiter) -> void

    def page_names: () -> Array[String]

    def page: (page_name: String) -> Page

    def update_page: (page_name: String, source: String) -> void

    def attachment_names: (page_name: String) -> Array[String]

    def attachment: (page_name: String, attachment_name: String) -> Attachment

    def add_attachment: (page_name: String, name: String, content: String) -> void

    def delete_attachment: (page_name: String, attachment_name: String) -> void

    private

    attr_reader api: API
  end
end
